{
  "manifest_version": 3,
  "name": "Media Link Collector",
  "version": "1.1.0",
  "description": "Collect media-related links from pages and present them in an action popup.",
  "permissions": ["tabs", "activeTab", "scripting", "downloads"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Media Links"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common/helpers.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"]
}
